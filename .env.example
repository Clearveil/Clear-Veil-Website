# Copy this file to `.env` for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Nothing in .env is committed to git.

# ── Contact form (Resend — https://resend.com) ─────────────────────────────
# API key from Resend → API Keys. Without it, local dev logs submissions to the
# terminal instead of emailing; production returns an error.
RESEND_API_KEY=
# Where form submissions are delivered.
CONTACT_TO_EMAIL=
# Sender address. Must be on a domain you've verified in Resend
# (e.g. "Clear Veil Website <website@clearveilmarketing.com>").
CONTACT_FROM_EMAIL=

# ── Tracking (leave blank to disable; tags only load when set) ─────────────
# Google Tag Manager container ID, e.g. GTM-ABC1234
PUBLIC_GTM_ID=
# Meta (Facebook) Pixel ID, e.g. 1234567890123456
PUBLIC_META_PIXEL_ID=
# Conversions API token (Events Manager → pixel → Settings → Conversions API →
# Generate access token). SECRET: add in Vercel as Sensitive, never commit it.
META_CAPI_TOKEN=
# Optional: Test Events code (e.g. TEST12345) while checking setup; remove after.
META_TEST_EVENT_CODE=
