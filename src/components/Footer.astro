---
import Mark from './Mark.astro';
import Wordmark from './Wordmark.astro';
import { footer, nav, site } from '../content/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="top">
      <div class="brand">
        <a href="/" class="logo" aria-label="Clear Veil Marketing, home">
          <Mark class="mark" />
          <Wordmark class="word" />
        </a>
        <p>{footer.tagline}</p>
        <a href={site.bookingUrl} class="btn btn-light btn-sm" target="_blank" rel="noopener">Book a 15-minute call</a>
      </div>
      <div class="cols">
        <div>
          <h2>Navigate</h2>
          <ul>
            <li><a href="/">Home</a></li>
            {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2>Social</h2>
          <ul>
            {site.social.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
            <li><a href={site.reviewsUrl} target="_blank" rel="noopener">Google reviews</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="bottom">
      <span>© {year} {site.legalName}</span>
      <span class="legal">
        <a href="/terms">Terms &amp; Conditions</a>
        <a href="/privacy">Privacy Policy</a>
      </span>
    </div>
  </div>
  <Wordmark class="giant" />
</footer>

<style>
  .footer {
    position: relative; overflow: hidden;
    padding-top: clamp(72px, 9vw, 112px);
    border-top: 1px solid var(--line);
    background: radial-gradient(70% 100% at 50% 100%, rgba(255, 255, 255, 0.05), transparent 70%);
  }
  .top { display: flex; justify-content: space-between; gap: 48px; flex-wrap: wrap; }
  .brand { max-width: 380px; display: grid; gap: 22px; justify-items: start; }
  .logo { display: flex; align-items: center; gap: 12px; color: #fff; }
  .mark { width: 40px; }
  .word { width: 108px; }
  .brand p { color: var(--ink-2); }

  .cols { display: flex; gap: clamp(48px, 8vw, 120px); }
  h2 { font-size: 0.8125rem; letter-spacing: 0; color: var(--ink-3); font-weight: 500; margin-bottom: 18px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  ul a { color: var(--ink-2); transition: color var(--t-fast) var(--ease); }
  ul a:hover { color: #fff; }

  .bottom {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    margin-top: 72px; padding: 24px 0;
    border-top: 1px solid var(--line);
    font-size: 0.875rem; color: var(--ink-3);
  }
  .legal { display: flex; gap: 24px; }
  .legal a:hover { color: #fff; }

  /* Oversized wordmark that bleeds off the bottom edge */
  .giant {
    width: calc(100% - var(--gutter) * 2); max-width: 1200px; margin: 8px auto -3.2%;
    color: rgba(255, 255, 255, 0.05);
    -webkit-mask-image: linear-gradient(180deg, #000 20%, transparent 95%);
    mask-image: linear-gradient(180deg, #000 20%, transparent 95%);
  }
</style>
