---
/** Google reviews, verbatim. Data: src/content/site.ts → reviews */
import { reviews, site, logoFor } from '../content/site';
import Arrow from './Arrow.astro';

// Each review shows its company's logo, sized to a consistent visual weight.
const withLogos = reviews.map((r) => {
  const c = logoFor(r.company);
  if (!c) return { ...r, logo: undefined };
  const ratio = c.w / c.h;
  const h = Math.round(Math.min(44, Math.max(22, Math.sqrt(2300 / ratio))));
  return { ...r, logo: { src: c.logo, h, w: Math.round(h * ratio) } };
});
---
<section class="section" id="reviews">
  <div class="container">
    <div class="head">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Reviews</span>
        <h2 class="h-display">What clients say about working with us.</h2>
      </div>
      <a href={site.reviewsUrl} class="google card" target="_blank" rel="noopener" data-reveal>
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span>Read them on Google</span>
        <Arrow />
      </a>
    </div>
    <div class="masonry">
      {withLogos.map((r, i) => (
        <figure class="review card" data-reveal style={`--i:${i % 3}`}>
          <div class="top">
            {r.logo && (
              <img class="logo" src={r.logo.src} alt={r.company} width={r.logo.w} height={r.logo.h} loading="lazy" decoding="async" />
            )}
            <span class="stars" aria-label="5 out of 5 stars">★★★★★</span>
          </div>
          <blockquote>{r.quote}</blockquote>
          <figcaption>
            <b>{r.name}</b>
            <small>{r.role}, {r.company}</small>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .head { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: clamp(40px, 5vw, 64px); flex-wrap: wrap; }
  .head .section-head { margin-bottom: 0; }
  .google {
    display: inline-flex; align-items: center; gap: 12px;
    padding: 14px 22px; border-radius: 999px; font-weight: 500; font-size: 0.875rem;
    transition: transform var(--t) var(--ease);
  }
  .google:hover { transform: translateY(-2px); }
  .google :global(svg) { width: 14px; }

  .masonry { columns: 3 300px; column-gap: 16px; }
  .review {
    break-inside: avoid; margin: 0 0 16px; padding: 26px 28px 28px;
    display: grid; gap: 20px;
  }
  .top {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    height: 64px; padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }
  .logo { opacity: 0.9; }
  .stars { color: #fff; letter-spacing: 3px; font-size: 0.75rem; text-shadow: 0 0 10px rgba(255, 255, 255, 0.45); }
  blockquote { margin: 0; font-size: var(--fs-card-quote); line-height: 1.65; color: rgba(255, 255, 255, 0.86); }
  figcaption { display: grid; gap: 2px; }
  figcaption b { font-weight: 500; font-size: 0.9rem; }
  figcaption small { color: var(--ink-3); font-size: var(--fs-card-meta); }
</style>
