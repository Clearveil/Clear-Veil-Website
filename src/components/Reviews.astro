---
/** Google reviews, verbatim. Data: src/content/site.ts → reviews */
import { reviews, site } from '../content/site';
import Arrow from './Arrow.astro';
const initials = (n: string) => n.split(' ').map((w) => w[0]).slice(0, 2).join('');
---
<section class="section" id="reviews">
  <div class="container">
    <div class="head">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Reviews</span>
        <h2 class="h-display">What clients say about working with us.</h2>
      </div>
      <a href={site.reviewsUrl} class="google card" target="_blank" rel="noopener" data-reveal>
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span>Read them on Google</span>
        <Arrow />
      </a>
    </div>
    <div class="masonry">
      {reviews.map((r, i) => (
        <figure class="review card" data-reveal style={`--i:${i % 3}`}>
          <span class="stars" aria-label="5 out of 5 stars">★★★★★</span>
          <blockquote>{r.quote}</blockquote>
          <figcaption>
            <span class="avatar" aria-hidden="true">{initials(r.name)}</span>
            <span>
              <b>{r.name}</b>
              <small>{r.role}, {r.company}</small>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .head { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: clamp(40px, 5vw, 64px); flex-wrap: wrap; }
  .head .section-head { margin-bottom: 0; }
  .google {
    display: inline-flex; align-items: center; gap: 12px;
    padding: 14px 20px; border-radius: 14px; font-weight: 500; font-size: 0.95rem;
    transition: transform var(--t) var(--ease);
  }
  .google:hover { transform: translateY(-2px); }
  .google :global(svg) { width: 14px; }

  .masonry { columns: 3 300px; column-gap: 16px; }
  .review {
    break-inside: avoid; margin: 0 0 16px; padding: 28px;
    display: grid; gap: 18px;
  }
  .stars { color: #fff; letter-spacing: 3px; font-size: 0.85rem; text-shadow: 0 0 10px rgba(255, 255, 255, 0.45); }
  blockquote { margin: 0; font-size: 1.05rem; line-height: 1.6; color: rgba(255, 255, 255, 0.86); }
  figcaption { display: flex; align-items: center; gap: 12px; padding-top: 4px; }
  figcaption b { display: block; font-weight: 500; }
  figcaption small { color: var(--ink-3); font-size: 0.875rem; }
  .avatar {
    display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; flex: none;
    font-size: 0.8125rem; font-weight: 600; letter-spacing: 0;
    background: linear-gradient(180deg, #5a5a5a, #2c2c2c);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 2px 6px rgba(0, 0, 0, 0.6);
  }
</style>
