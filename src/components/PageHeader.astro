---
/** Title block at the top of inner pages. */
interface Props { eyebrow?: string; title: string; lede?: string }
const { eyebrow, title, lede } = Astro.props;
---
<header class="page-header container">
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h1>{title}</h1>
  {lede && <p>{lede}</p>}
  <slot />
</header>

<style>
  .page-header { display: grid; gap: 22px; justify-items: start; padding-top: clamp(56px, 8vw, 112px); padding-bottom: clamp(40px, 5vw, 72px); }
  h1 {
    font-size: clamp(2.8rem, 1.6rem + 4.6vw, 5.4rem); line-height: 1; letter-spacing: -0.05em; max-width: 16ch;
    background: linear-gradient(100deg, #fff 35%, rgba(255, 255, 255, 0.5) 130%);
    -webkit-background-clip: text; background-clip: text; color: transparent; padding-bottom: 0.06em;
  }
  p { color: var(--ink-2); font-size: var(--fs-lede); max-width: var(--measure); }
</style>
