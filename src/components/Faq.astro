---
/** Questions and answers as glass accordions (native <details>, works without JS). */
interface Props { eyebrow: string; title: string; items: { q: string; a: string }[] }
const { eyebrow, title, items } = Astro.props;
---
<section class="section faq">
  <div class="container split">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="h-display">{title}</h2>
    </div>
    <div class="list">
      {items.map((f, i) => (
        <details class="qa card" data-reveal style={`--i:${i}`} open={i === 0}>
          <summary>
            <span>{f.q}</span>
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .split { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .list { display: grid; gap: 10px; }
  .qa { border-radius: var(--r-lg); padding: 0; }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 24px;
    cursor: pointer; list-style: none; font-size: 1rem; letter-spacing: -0.015em;
  }
  summary::-webkit-details-marker { display: none; }
  .plus { position: relative; flex: none; width: 28px; height: 28px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16); }
  .plus::before, .plus::after {
    content: ''; position: absolute; left: 50%; top: 50%; width: 10px; height: 1.5px; background: #fff;
    transform: translate(-50%, -50%); transition: transform var(--t) var(--ease);
  }
  .plus::after { transform: translate(-50%, -50%) rotate(90deg); }
  .qa[open] .plus::after { transform: translate(-50%, -50%) rotate(0deg); }
  p { padding: 0 24px 22px; color: var(--ink-2); font-size: var(--fs-card); line-height: 1.7; max-width: 620px; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } .section-head { margin-bottom: 8px; } }
</style>
