---
/**
 * Tiny easter egg on the contact page: a phone sending a signal to a laptop.
 * Loops quietly; when the contact form sends successfully it plays a quick,
 * brighter burst (listens for the "cv:sent" event fired by Contact.astro).
 */
---
<div class="doodle" data-doodle aria-hidden="true">
  <svg viewBox="0 0 160 48" fill="none">
    <!-- phone -->
    <rect x="6" y="8" width="18" height="32" rx="4" stroke="currentColor" stroke-width="1.4" />
    <line x1="12.5" y1="12" x2="17.5" y2="12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    <path class="arc a1" d="M28 19.5a6 6 0 0 1 0 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    <path class="arc a2" d="M31 16.5a10.5 10.5 0 0 1 0 15" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />

    <!-- signal -->
    {[44, 56, 68, 80, 92].map((x, i) => (
      <circle class="dot" cx={x} cy="24" r="1.7" fill="currentColor" style={`--d:${i}`} />
    ))}

    <!-- laptop -->
    <rect x="110" y="11" width="38" height="24" rx="2.5" stroke="currentColor" stroke-width="1.4" />
    <rect class="screen" x="113" y="14" width="32" height="18" rx="1" fill="currentColor" />
    <path d="M104 38.5h50l-3 3.5h-44z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
  </svg>
</div>

<script>
  const el = document.querySelector<HTMLElement>('[data-doodle]');
  if (el) {
    window.addEventListener('cv:sent', () => {
      el.classList.remove('burst');
      void el.offsetWidth; // restart the animation if it's already running
      el.classList.add('burst');
      setTimeout(() => el.classList.remove('burst'), 2800);
    });
  }
</script>

<style>
  .doodle {
    --cycle: 3.2s;
    width: 132px; margin: 40px auto 0;
    color: rgba(255, 255, 255, 0.32);
    transition: color var(--t) var(--ease);
  }
  .doodle:hover { color: rgba(255, 255, 255, 0.6); }
  svg { display: block; width: 100%; height: auto; overflow: visible; }

  /* Dots light up one after another, phone → laptop */
  .dot { opacity: 0.15; animation: hop var(--cycle) var(--ease-in-out) infinite; animation-delay: calc(var(--d) * var(--cycle) / 12); }
  @keyframes hop {
    0%, 100% { opacity: 0.15; }
    12% { opacity: 1; }
    30% { opacity: 0.15; }
  }

  /* Signal arcs pulse outward from the phone */
  .arc { opacity: 0; animation: pulse var(--cycle) ease-out infinite; }
  .a2 { animation-delay: calc(var(--cycle) / 16); }
  @keyframes pulse {
    0% { opacity: 0; }
    6% { opacity: 1; }
    24%, 100% { opacity: 0; }
  }

  /* Laptop screen glows as the signal arrives */
  .screen { opacity: 0.04; animation: glow var(--cycle) var(--ease) infinite; }
  @keyframes glow {
    0%, 42% { opacity: 0.04; }
    52% { opacity: 0.35; }
    75%, 100% { opacity: 0.04; }
  }

  /* Form sent: quick, bright burst */
  .doodle.burst { --cycle: 0.9s; color: rgba(255, 255, 255, 0.85); }

  @media (prefers-reduced-motion: reduce) {
    .dot, .arc, .screen { animation: none; }
    .dot { opacity: 0.5; }
    .arc { opacity: 0.6; }
  }
</style>
