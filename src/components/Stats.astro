---
import { stats as defaultStats } from '../content/site';
interface Props { items?: { value: string; label: string }[] }
const { items: stats = defaultStats } = Astro.props;
---
<section class="stats-section">
  <div class="container">
    <div class="band card" data-reveal style={`--n:${stats.length}`}>
      {stats.map((s, i) => (
        <div class="stat" style={`--i:${i}`}>
          <span class="value">{s.value}</span>
          <span class="label">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats-section { padding-top: clamp(56px, 7vw, 96px); }
  .band {
    display: grid; grid-template-columns: repeat(var(--n, 3), 1fr);
    border-radius: var(--r-xl); overflow: hidden;
  }
  .stat {
    display: grid; gap: 6px; padding: clamp(32px, 4vw, 52px) clamp(24px, 3vw, 44px);
    text-align: center;
  }
  .stat + .stat { box-shadow: inset 1px 0 0 var(--line); }
  .value {
    font-size: clamp(2.6rem, 1.8rem + 3vw, 4.25rem); line-height: 1; letter-spacing: -0.05em;
    background: linear-gradient(180deg, #fff 30%, rgba(255, 255, 255, 0.55));
    -webkit-background-clip: text; background-clip: text; color: transparent;
    padding-bottom: 0.06em;
  }
  .label { color: var(--ink-2); font-size: var(--fs-card); }

  /* Four numbers: 2x2 on tablets and phones */
  @media (max-width: 900px) {
    .band[style*="--n:4"] { grid-template-columns: 1fr 1fr; }
    .band[style*="--n:4"] .stat:nth-child(odd) { box-shadow: none; }
    .band[style*="--n:4"] .stat:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 720px) {
    .band:not([style*="--n:4"]) { grid-template-columns: 1fr; }
    .stat + .stat { box-shadow: inset 0 1px 0 var(--line); }
    .stat { padding: 28px 24px; }
  }
</style>
