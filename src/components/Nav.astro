---
/**
 * Floating glass capsule nav.
 * Desktop: brand · links (with a glass pill that glides to the hovered link) · CTA
 * Mobile: the capsule itself expands into the menu.
 */
import Wordmark from './Wordmark.astro';
import Mark from './Mark.astro';
import Arrow from './Arrow.astro';
import { nav, site } from '../content/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="nav" data-nav>
  <div class="bar glass">
    <div class="row">
      <a href="/" class="brand" aria-label="Clear Veil Marketing, home">
        <Mark class="brand-mark" />
        <Wordmark class="brand-word" />
      </a>

      <nav class="links" aria-label="Main" data-links>
        <span class="indicator" aria-hidden="true" data-indicator></span>
        {nav.map((l) => (
          <a href={l.href} aria-current={l.href === path ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>

      <div class="end">
        <a href={site.bookingUrl} class="btn btn-light btn-sm cta" target="_blank" rel="noopener">
          Book a call<Arrow />
        </a>
        <button class="menu-btn glass" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
          <span class="sr-only">Menu</span>
          <span class="lines" aria-hidden="true"><i></i><i></i></span>
        </button>
      </div>
    </div>

    <div class="mobile" id="mobile-menu" data-menu>
      <div class="mobile-clip">
        <nav class="mobile-inner" aria-label="Mobile">
          {nav.map((l, i) => (
            <a href={l.href} style={`--i:${i}`} aria-current={l.href === path ? 'page' : undefined}>
              {l.label}<Arrow />
            </a>
          ))}
          <a href={site.bookingUrl} class="btn btn-light" target="_blank" rel="noopener" style={`--i:${nav.length}`}>
            Book a 15-minute call<Arrow />
          </a>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]')!;
  const btn = header.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const links = header.querySelector<HTMLElement>('[data-links]')!;
  const indicator = header.querySelector<HTMLElement>('[data-indicator]')!;

  // Denser glass once the page scrolls under the bar
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Gliding hover pill. Rests on the current page's link, if there is one.
  const current = links.querySelector<HTMLElement>('[aria-current="page"]');
  const moveTo = (a: HTMLElement | null) => {
    if (!a) { indicator.style.opacity = '0'; return; }
    indicator.style.opacity = '1';
    indicator.style.width = `${a.offsetWidth}px`;
    indicator.style.transform = `translateX(${a.offsetLeft}px)`;
  };
  links.querySelectorAll<HTMLElement>('a').forEach((a) => a.addEventListener('mouseenter', () => moveTo(a)));
  links.addEventListener('mouseleave', () => moveTo(current));
  // Place without animating on first paint
  indicator.style.transition = 'none';
  moveTo(current);
  requestAnimationFrame(() => (indicator.style.transition = ''));
  window.addEventListener('resize', () => moveTo(current));

  // Mobile menu
  const setOpen = (open: boolean) => {
    header.classList.toggle('is-open', open);
    btn.setAttribute('aria-expanded', String(open));
  };
  btn.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
  header.querySelectorAll('[data-menu] a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  window.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>

<style>
  /* Fixed height: when the capsule grows into the mobile menu it floats over
     the page instead of pushing content down. */
  .nav {
    position: sticky; top: 0; z-index: 50;
    height: 74px;
    padding: 14px var(--gutter) 0;
  }

  /* The capsule. Height 60 + radius 30 = a perfect pill. */
  .bar {
    --glass-fill-top: rgba(255, 255, 255, 0.07);
    --glass-fill-bottom: rgba(255, 255, 255, 0.015);
    --rim: rgba(255, 255, 255, 0.32);
    max-width: var(--max); margin: 0 auto;
    border-radius: 30px;
    transition: border-radius var(--t) var(--ease-in-out), background var(--t) var(--ease), box-shadow var(--t) var(--ease);
  }
  .nav.is-scrolled .bar,
  .nav.is-open .bar {
    --glass-blur: 22px;
    --glass-fill-top: rgba(28, 28, 28, 0.72);
    --glass-fill-bottom: rgba(12, 12, 12, 0.66);
    --rim: rgba(255, 255, 255, 0.4);
  }
  .bar::after { display: none; } /* no cursor sheen on the bar itself */

  .row {
    height: 60px; padding: 0 9px 0 22px;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px;
  }

  .brand { display: flex; align-items: center; gap: 11px; color: #fff; justify-self: start; }
  .brand-mark { width: 32px; height: auto; }
  .brand-word { width: 96px; height: auto; opacity: 0.92; }

  /* Links + gliding glass pill */
  .links { position: relative; display: flex; gap: 2px; }
  .links a {
    position: relative; z-index: 1;
    padding: 9px 15px; border-radius: 999px;
    font-size: 0.925rem; color: rgba(255, 255, 255, 0.66);
    transition: color var(--t-fast) var(--ease);
  }
  .links a:hover, .links a[aria-current='page'] { color: #fff; }
  .indicator {
    position: absolute; left: 0; top: 0; height: 100%; width: 0;
    border-radius: 999px; opacity: 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.13), rgba(255, 255, 255, 0.04));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), inset 0 0 0 1px rgba(255, 255, 255, 0.08), inset 0 8px 14px -10px rgba(255, 255, 255, 0.4);
    transition: transform var(--t) var(--ease), width var(--t) var(--ease), opacity var(--t-fast) var(--ease);
  }

  .end { justify-self: end; display: flex; align-items: center; gap: 8px; }

  /* Menu button: glass circle, two offset lines that become an X */
  .menu-btn {
    display: none;
    width: 42px; height: 42px; border: 0; border-radius: 50%; cursor: pointer;
    place-items: center;
  }
  .lines { position: relative; width: 18px; height: 10px; }
  .lines i {
    position: absolute; right: 0; height: 1.5px; border-radius: 2px; background: #fff;
    transition: transform var(--t) var(--ease), top var(--t) var(--ease), width var(--t) var(--ease);
  }
  .lines i:first-child { top: 0; width: 18px; }
  .lines i:last-child { top: 8.5px; width: 11px; }
  .nav.is-open .lines i { width: 18px; top: 4.25px; }
  .nav.is-open .lines i:first-child { transform: rotate(45deg); }
  .nav.is-open .lines i:last-child { transform: rotate(-45deg); }

  /* Mobile panel lives inside the capsule and grows it */
  .mobile { display: grid; grid-template-rows: 0fr; transition: grid-template-rows var(--t) var(--ease-in-out); }
  .mobile-clip { overflow: hidden; }
  .nav.is-open .mobile { grid-template-rows: 1fr; }
  .mobile-inner { display: grid; padding: 4px 22px 22px; }
  .mobile-inner a:not(.btn) {
    display: flex; justify-content: space-between; align-items: center;
    padding: 15px 2px; font-size: 1.4rem; letter-spacing: -0.03em;
    border-top: 1px solid var(--line);
  }
  .mobile-inner a:not(.btn) :global(svg) { width: 16px; color: var(--ink-3); }
  .mobile-inner a[aria-current='page'] { color: #fff; }
  .mobile-inner .btn { margin-top: 18px; }
  .mobile-inner > * {
    opacity: 0; transform: translateY(-6px);
    transition: opacity var(--t) var(--ease), transform var(--t) var(--ease);
  }
  .nav.is-open .mobile-inner > * { opacity: 1; transform: none; transition-delay: calc(90ms + var(--i) * 40ms); }

  @media (max-width: 900px) {
    .nav { padding-top: 10px; height: 68px; }
    .row { grid-template-columns: 1fr auto; padding: 0 8px 0 18px; height: 58px; }
    .links { display: none; }
    .menu-btn { display: grid; }
    .nav.is-open .bar { border-radius: 26px; }
  }
  @media (min-width: 901px) { .mobile { display: none; } }
  @media (max-width: 400px) {
    .brand-word { display: none; }
  }
</style>
