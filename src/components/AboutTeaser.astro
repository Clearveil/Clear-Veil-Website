---
import { about } from '../content/site';
import Arrow from './Arrow.astro';
---
<section class="section about" id="about">
  <div class="container grid">
    <div class="photos" data-reveal>
      <img class="p1" src={about.images[0].src} alt={about.images[0].alt} width="720" height="900" loading="lazy" decoding="async" />
      <img class="p2" src={about.images[1].src} alt={about.images[1].alt} width="720" height="900" loading="lazy" decoding="async" />
    </div>
    <div class="copy">
      <div class="section-head" data-reveal>
        <span class="eyebrow">{about.eyebrow}</span>
        <h2 class="h-display">{about.title}</h2>
      </div>
      <div class="body" data-reveal style="--i:1">
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <a href="/about" class="link" data-reveal style="--i:2">More about us <Arrow /></a>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(48px, 7vw, 112px); align-items: center; }
  .photos { position: relative; aspect-ratio: 4 / 5; }
  .photos img {
    position: absolute; object-fit: cover; border-radius: var(--r-lg);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1), 0 40px 80px -30px rgba(0, 0, 0, 1);
  }
  .p1 { inset: 0 22% 12% 0; width: 78%; height: 88%; }
  .p2 {
    right: 0; bottom: 0; width: 50%; height: 56%;
    outline: 6px solid #000; /* separates the overlapping photo */
    filter: grayscale(0.15);
  }
  .copy .section-head { margin-bottom: 28px; }
  .body { display: grid; gap: 16px; color: var(--ink-2); font-size: var(--fs-lede); max-width: 560px; }
  .link { margin-top: 32px; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .photos { order: 2; max-width: 520px; }
  }
</style>
