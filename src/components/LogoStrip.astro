---
/** Slow client-logo marquee. Logos are set in src/content/site.ts → clients. */
import { clients as allClients } from '../content/site';

interface Props { only?: string[]; label?: string } // only: client names, in display order
const { only, label = 'Trusted by growing brands' } = Astro.props;
// match by name, or by logo path for marks that don't have a name yet
const clients = only ? only.map((n) => allClients.find((c) => c.name === n || c.logo === n)!).filter(Boolean) : allClients;

// Give every logo roughly the same visual area, so a wide wordmark and a round
// badge feel equally weighted instead of one dwarfing the other.
const AREA = 4600;
const sized = clients.map((c) => {
  const ratio = c.w / c.h;
  const h = Math.round(Math.min(62, Math.max(30, Math.sqrt(AREA / ratio))));
  return { ...c, h, w: Math.round(h * ratio) };
});
// Two copies side by side so the loop is seamless.
const loop = [...sized, ...sized];
---
<section class="strip" aria-label="Clients we work with">
  <p class="label">{label}</p>
  <div class="viewport">
    <ul class="track">
      {loop.map((c, i) => (
        <li aria-hidden={i >= sized.length ? 'true' : undefined}>
          <img
            src={c.logo}
            alt={i >= sized.length ? '' : c.name}
            width={c.w}
            height={c.h}
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .strip { padding-block: 8px 24px; }
  .label { text-align: center; font-size: 0.8125rem; color: var(--ink-3); margin-bottom: 30px; }
  .viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .track {
    list-style: none; margin: 0; padding: 0;
    display: flex; align-items: center; width: max-content;
    animation: marquee 90s linear infinite;
  }
  .viewport:hover .track { animation-play-state: paused; }
  li { flex: none; display: grid; place-items: center; padding: 0 clamp(26px, 3.4vw, 48px); height: 72px; }
  img {
    opacity: 0.5;
    transition: opacity var(--t) var(--ease), filter var(--t) var(--ease);
  }
  li:hover img { opacity: 1; filter: drop-shadow(0 0 14px rgba(255, 255, 255, 0.35)); }

  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; flex-wrap: wrap; justify-content: center; width: auto; }
    li[aria-hidden='true'] { display: none; }
  }
</style>
