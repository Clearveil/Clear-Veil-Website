---
import Reel from './Reel.astro';
import Mark from './Mark.astro';
import Arrow from './Arrow.astro';
import { hero } from '../content/site';
---
<section class="hero">
  <div class="container grid">
    <div class="copy">
      <span class="status"><b>New</b>{hero.status}</span>
      <Mark class="mark" />
      <h1>
        <span>{hero.headline[0]}</span>
        <span>{hero.headline[1]}</span>
      </h1>
      <p class="lede">{hero.lede}</p>
      <div class="actions">
        <a class="btn btn-light" href={hero.primary.href} target="_blank" rel="noopener">
          {hero.primary.label}<Arrow />
        </a>
        <a class="btn btn-glass" href={hero.secondary.href}>{hero.secondary.label}</a>
      </div>
    </div>
    <div class="media">
      <Reel />
    </div>
  </div>
</section>

<style>
  .hero { padding-top: clamp(40px, 7vw, 96px); padding-bottom: clamp(64px, 8vw, 112px); }
  .grid {
    display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(40px, 6vw, 96px); align-items: center;
  }
  .copy { display: grid; justify-items: start; }

  .status {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 5px 14px 5px 5px; border-radius: 10px;
    font-size: 0.875rem; color: rgba(255, 255, 255, 0.85);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.03));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), inset 0 0 0 1px rgba(255, 255, 255, 0.07);
  }
  .status b {
    padding: 3px 8px; border-radius: 6px;
    font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
    background: linear-gradient(180deg, #6a6a6a, #444);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  .mark { width: 96px; margin: 40px 0 26px; color: #fff; filter: drop-shadow(0 0 18px rgba(255, 255, 255, 0.25)); }

  h1 {
    font-size: var(--fs-hero);
    line-height: 0.98;
    letter-spacing: -0.052em;
    display: grid;
  }
  h1 span {
    background: linear-gradient(100deg, #fff 35%, rgba(255, 255, 255, 0.5) 130%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    padding-bottom: 0.08em;
  }
  .lede { margin-top: 26px; max-width: 520px; font-size: var(--fs-lede); color: var(--ink-2); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .mark { width: 76px; margin: 30px 0 20px; }
    .media { margin-top: 12px; }
  }
  @media (max-width: 480px) {
    .actions { width: 100%; }
    .actions .btn { flex: 1 1 100%; }
  }
</style>
