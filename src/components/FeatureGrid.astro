---
/** "What's included" grid: numbered glass cards, three across. */
interface Props { eyebrow: string; title: string; intro?: string; items: { name: string; body: string }[] }
const { eyebrow, title, intro, items } = Astro.props;
---
<section class="section feature-grid">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="h-display">{title}</h2>
      {intro && <p>{intro}</p>}
    </div>
    <ul class="grid">
      {items.map((f, i) => (
        <li class="item card" data-reveal style={`--i:${i % 3}`}>
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{f.name}</h3>
          <p>{f.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .item { display: flex; flex-direction: column; gap: 12px; padding: 26px 26px 28px; transition: transform var(--t) var(--ease); }
  .item:hover { transform: translateY(-3px); --rim: rgba(255, 255, 255, 0.5); }
  .n { font-size: var(--fs-card-meta); color: var(--ink-3); margin-bottom: 26px; font-variant-numeric: tabular-nums; }
  h3 { font-size: 1.15rem; letter-spacing: -0.025em; }
  p { color: var(--ink-2); font-size: var(--fs-card); line-height: 1.65; }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } .n { margin-bottom: 12px; } }
</style>
