---
/** Clickable service cards that lead to their own landing pages. The featured one is larger. */
import Arrow from './Arrow.astro';

type Item = { href: string; tag: string; name: string; body: string; points: string[]; cta: string; featured?: boolean };
interface Props { eyebrow: string; title: string; intro?: string; items: Item[] }
const { eyebrow, title, intro, items } = Astro.props;
---
<section class="section services-links" id="services">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="h-display">{title}</h2>
      {intro && <p>{intro}</p>}
    </div>
    <div class:list={["grid", { stacked: items.length > 2 }]}>
      {items.map((s, i) => (
        <a class:list={['svc card', { featured: s.featured }]} href={s.href} data-reveal style={`--i:${i}`}>
          <span class="tag-top">{s.tag}</span>
          <h3>{s.name}</h3>
          <p>{s.body}</p>
          <ul>{s.points.map((x) => <li class="tag">{x}</li>)}</ul>
          <span class="cta">{s.cta} <Arrow /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 16px; }
  .svc {
    display: flex; flex-direction: column; gap: 16px; padding: clamp(26px, 3vw, 40px); min-height: 400px;
    transition: transform var(--t) var(--ease);
  }
  .svc:hover { transform: translateY(-4px); --rim: rgba(255, 255, 255, 0.55); }
  .featured { --glass-fill-top: rgba(255, 255, 255, 0.1); --rim: rgba(255, 255, 255, 0.45); }
  .tag-top {
    align-self: flex-start; margin-bottom: auto; font-size: var(--fs-card-meta); color: var(--ink-2);
    padding: 5px 12px; border-radius: 8px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.02));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25), inset 0 0 0 1px rgba(255, 255, 255, 0.07);
  }
  .featured .tag-top { color: #111; background: #fff; box-shadow: none; }
  h3 { margin-top: 48px; font-size: clamp(1.7rem, 1.3rem + 1.3vw, 2.5rem); letter-spacing: -0.04em; }
  .featured h3 { font-size: clamp(2rem, 1.4rem + 1.8vw, 3rem); }
  p { color: var(--ink-2); font-size: var(--fs-card); line-height: 1.65; max-width: var(--measure); }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .cta { display: inline-flex; align-items: center; gap: 8px; margin-top: 6px; font-size: 0.9rem; color: #fff; }
  .cta :global(svg) { width: 15px; height: 15px; flex: none; transition: transform var(--t) var(--ease); }
  .svc:hover .cta :global(svg) { transform: translateX(4px); }
  /* Three cards: the featured one runs full width on top (copy left, checklist right),
     the two add-ons sit side by side underneath */
  .stacked { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .stacked .svc { min-height: 0; }
  .stacked .svc:not(.featured) h3 { margin-top: 28px; font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); }
  .stacked .featured {
    grid-column: 1 / -1; display: grid; align-items: start; column-gap: clamp(32px, 6vw, 96px);
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    grid-template-areas: 'tag points' 'name points' 'body points' 'cta points';
  }
  .stacked .featured .tag-top { grid-area: tag; justify-self: start; margin-bottom: 0; }
  .stacked .featured h3 { grid-area: name; margin-top: 32px; }
  .stacked .featured p { grid-area: body; }
  .stacked .featured .cta { grid-area: cta; justify-self: start; }
  .stacked .featured ul { grid-area: points; align-self: center; display: grid; gap: 10px; }
  .stacked .featured li {
    display: flex; align-items: center; gap: 12px; height: auto; padding: 14px 18px; border-radius: 14px;
    font-size: var(--fs-card); color: #fff;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.015));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14), inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .stacked .featured li::before {
    content: ''; flex: none; width: 7px; height: 7px; border-radius: 50%;
    background: #fff; box-shadow: 0 0 10px 1px rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 900px) {
    .grid, .stacked { grid-template-columns: 1fr; }
    .svc { min-height: 0; }
    h3 { margin-top: 28px; }
    .stacked .featured { grid-template-columns: 1fr; grid-template-areas: 'tag' 'name' 'body' 'points' 'cta'; row-gap: 16px; }
    .stacked .featured h3 { margin-top: 12px; }
    .stacked .featured ul { margin-top: 4px; }
  }
</style>
