---
/**
 * Google Tag Manager + Meta Pixel.
 * Each loads only if its ID is set in the environment (see .env.example), so
 * the site runs clean with no tracking until you're ready for ads.
 *
 * `slot="head"` goes in <head>; `slot="body"` is the <noscript> fallback that
 * goes right after <body>.
 */
interface Props { slot: 'head' | 'body' }
const { slot } = Astro.props;
const GTM = import.meta.env.PUBLIC_GTM_ID;
const PIXEL = import.meta.env.PUBLIC_META_PIXEL_ID;
---
{slot === 'head' && GTM && (
  <script is:inline define:vars={{ GTM }}>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',GTM);
  </script>
)}
{slot === 'head' && PIXEL && (
  <script is:inline define:vars={{ PIXEL }}>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', PIXEL);
    fbq('track', 'PageView');
  </script>
)}
{slot === 'body' && GTM && (
  <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
)}
{slot === 'body' && PIXEL && (
  <noscript><img height="1" width="1" style="display:none" alt="" src={`https://www.facebook.com/tr?id=${PIXEL}&ev=PageView&noscript=1`} /></noscript>
)}
