---
/**
 * The shell every page uses: <head> (title, description, social preview,
 * tracking), the nav, the page content, and the footer.
 */
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Tracking from '../components/Tracking.astro';
import { site } from '../content/site';

interface Props {
  title?: string;        // short page name; "| Clear Veil Marketing" is appended
  seoTitle?: string;     // full title for search results (overrides title), aim for ≤ 60 characters
  description?: string;  // search snippet, aim for 120–160 characters
  image?: string;        // social share image (1200×630), defaults to /og.png
  noindex?: boolean;     // keep a page out of Google (e.g. unfinished case studies)
  type?: 'website' | 'article';
  breadcrumbs?: { name: string; path: string }[]; // trail after Home, for Google's breadcrumb display
  schema?: Record<string, unknown>[];             // extra structured data for this page
  minimal?: boolean;     // ad landing pages: stripped-down header/footer
}

const {
  title, seoTitle, description = site.description, image = '/og.png', noindex = false,
  type = 'website', breadcrumbs, schema = [], minimal = false,
} = Astro.props;
const fullTitle = seoTitle ?? (title ? `${title} | ${site.name}` : `${site.name} | Paid Ads, Websites & Creative`);
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;
const ogImage = new URL(image, site.url).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#organization`, // city pages point their Service at this
  name: site.legalName,
  url: site.url,
  logo: new URL('/icon-512.png', site.url).href,
  image: ogImage,
  description: site.description,
  telephone: site.phone,
  areaServed: 'US',
  address: { '@type': 'PostalAddress', addressRegion: 'MI', addressCountry: 'US' },
  sameAs: site.social.map((s) => s.href),
};

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const pageSchema: Record<string, unknown>[] = [orgSchema];
if (isHome) {
  pageSchema.push({ '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url });
}
if (breadcrumbs?.length) {
  const trail = [{ name: 'Home', path: '/' }, ...breadcrumbs];
  pageSchema.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: trail.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: new URL(b.path, site.url).href })),
  });
}
pageSchema.push(...schema);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#000000" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {pageSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <!-- Marks JS as available so scroll reveals can hide content until it's in view -->
    <script is:inline>document.documentElement.classList.add('js')</script>
    <Tracking slot="head" />
  </head>
  <body>
    <Tracking slot="body" />
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="glow" aria-hidden="true"></div>
    <div class="ambient" aria-hidden="true"><i></i><i></i><i></i></div>
    <Nav minimal={minimal} />
    <main id="main">
      <slot />
    </main>
    <Footer minimal={minimal} />

    <script>
      // Pixel + GTM tracking for call, text and Book-a-call clicks
      import '../scripts/click-tracking';

      // Liquid-glass sheen: tell each glass element where the cursor is so its
      // highlight can follow it. Mouse/trackpad only; skipped on touch.
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        document.addEventListener('pointermove', (e) => {
          const el = (e.target as Element).closest?.<HTMLElement>('.glass, .btn-glass, .btn-glass, .card');
          if (!el) return;
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${e.clientX - r.left}px`);
          el.style.setProperty('--my', `${e.clientY - r.top}px`);
        }, { passive: true });
      }

      // Scroll reveal: fade sections up as they enter the viewport (once).
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>

<style>
  /* The soft light bloom in the top corner — the current site's signature */
  .glow {
    position: absolute;
    inset: 0 0 auto 0;
    height: 1100px;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(60% 55% at 88% -8%, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.06) 38%, transparent 70%),
      radial-gradient(40% 40% at 8% 0%, rgba(255, 255, 255, 0.05) 0%, transparent 70%);
  }
  main { position: relative; z-index: 1; }

  /* Soft light that drifts slowly behind everything, so the glass surfaces
     have something to refract instead of flat black. */
  .ambient { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .ambient i {
    position: absolute; width: 46vmax; height: 46vmax; border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.045) 0%, rgba(255, 255, 255, 0.012) 40%, transparent 65%);
    animation: drift 46s var(--ease-in-out) infinite alternate;
  }
  .ambient i:nth-child(1) { top: -12vmax; left: -14vmax; }
  .ambient i:nth-child(2) { top: 30vh; right: -18vmax; animation-duration: 58s; animation-delay: -20s; }
  .ambient i:nth-child(3) { bottom: -20vmax; left: 20vw; animation-duration: 64s; animation-delay: -34s; opacity: 0.7; }
  @keyframes drift {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(6vw, 4vh, 0) scale(1.12); }
    100% { transform: translate3d(-4vw, 8vh, 0) scale(0.94); }
  }
</style>
