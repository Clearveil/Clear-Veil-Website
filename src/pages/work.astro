---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { work, reviews, site, logoFor } from '../content/site';
import Arrow from '../components/Arrow.astro';

// Pair each project with that client's Google review, when there is one.
// Search snippet built from the top results, so it stays current as numbers change
const topResults = work.filter((w) => w.result).slice(0, 2).map((w) => `${w.result} for ${w.client}`).join(', ');
const workDescription = `Real client results: ${topResults}. Case studies in paid ads, websites and creative.`;

const projects = work.map((w) => {
  const c = logoFor(w.client);
  const logo = c && (() => {
    const ratio = c.w / c.h;
    const h = Math.round(Math.min(52, Math.max(26, Math.sqrt(3200 / ratio))));
    return { src: c.logo, h, w: Math.round(h * ratio) };
  })();
  return { ...w, logo, review: reviews.find((r) => r.company === w.client) };
});
---
<Base
  seoTitle="Case Studies & Client Results | Clear Veil Marketing"
  description={workDescription}
  breadcrumbs={[{ name: 'Work', path: '/work' }]}
>
  <PageHeader eyebrow="Work" title="Selected work" lede="What we did, for whom, in their words." />

  <section class="container list">
    {projects.map((p, i) => (
      <article class="project card" id={p.slug} data-reveal style={`--i:${i % 2}`}>
        <div class="meta">
          <div class="idrow">
            <span class="idx">0{i + 1}</span>
            {p.logo && <img class="logo" src={p.logo.src} alt="" width={p.logo.w} height={p.logo.h} loading="lazy" decoding="async" />}
          </div>
          <h2><a href={`/work/${p.slug}`}>{p.client}</a></h2>
          <p class="what">{p.what}</p>
          <ul>{p.services.map((s) => <li class="tag">{s}</li>)}</ul>
          <div class="foot">
            {p.result && <p class="result">{p.result}</p>}
            <a class="link read" href={`/work/${p.slug}`}>Read case study <Arrow /></a>
          </div>
        </div>
        {p.review && (
          <figure class="quote">
            <blockquote>“{p.review.quote}”</blockquote>
            <figcaption>{p.review.name}, {p.review.role}</figcaption>
          </figure>
        )}
      </article>
    ))}
    <p class="more">
      More client feedback on <a class="link" href={site.reviewsUrl} target="_blank" rel="noopener">Google <Arrow /></a>
    </p>
  </section>

  <CtaBand />
</Base>

<style>
  /* ── Phones (base) ─────────────────────────────────────────────────── */
  .list { display: grid; gap: 16px; }
  .project {
    display: grid; grid-template-columns: 1fr; gap: clamp(28px, 5vw, 72px);
    padding: clamp(28px, 4vw, 48px); scroll-margin-top: 110px;
  }
  .meta { display: grid; gap: 12px; align-content: start; justify-items: start; }
  .foot { display: contents; } /* children sit in .meta's grid as before */
  .idrow { display: flex; align-items: center; justify-content: space-between; justify-self: stretch; min-height: 52px; }
  .idx { font-size: var(--fs-card-meta); color: var(--ink-3); }
  .logo { opacity: 0.85; }
  h2 { font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.75rem); }
  h2 a { transition: opacity var(--t-fast) var(--ease); }
  h2 a:hover { opacity: 0.8; }
  .read { margin-top: 14px; font-size: 0.9rem; }
  .what { color: var(--ink-2); font-size: var(--fs-card); }
  ul { list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .result {
    margin-top: 8px; font-weight: 500; font-size: var(--fs-card-meta); padding: 6px 14px; border-radius: 999px;
    color: #fff;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.04));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), inset 0 0 0 1px rgba(255, 255, 255, 0.12), 0 0 14px -4px rgba(255, 255, 255, 0.25);
  }
  .quote { margin: 0; display: grid; gap: 16px; align-content: center; border-top: 1px solid var(--line); padding-top: 24px; }
  blockquote { margin: 0; font-size: var(--fs-card-quote); line-height: 1.65; color: rgba(255, 255, 255, 0.86); }
  figcaption { color: var(--ink-3); font-size: var(--fs-card-meta); }
  .more { color: var(--ink-2); margin-top: 24px; text-align: center; }

  /* ── Desktop: two-column gallery of equal-height cards ─────────────── */
  @media (min-width: 801px) {
    .list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .more { grid-column: 1 / -1; }
    .project {
      display: flex; flex-direction: column; gap: 0;
      padding: 30px 32px 26px;
      transition: transform var(--t) var(--ease);
    }
    .project:hover { transform: translateY(-3px); --rim: rgba(255, 255, 255, 0.5); }
    .meta { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; flex: 1; }

    /* Logo in a small glass tile on the left, index on the right */
    .idrow { flex-direction: row-reverse; align-self: stretch; min-height: 0; margin-bottom: 14px; }
    .logo {
      box-sizing: content-box;
      max-height: 34px; width: auto; padding: 14px 18px; border-radius: 16px; opacity: 1;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.02));
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), inset 0 0 0 1px rgba(255, 255, 255, 0.07);
    }
    h2 { font-size: clamp(1.6rem, 1.2rem + 0.9vw, 2.1rem); }
    .what { max-width: 440px; }

    /* Result + read link pinned to the bottom so every card lines up */
    .foot {
      display: flex; align-items: center; gap: 16px; align-self: stretch;
      margin-top: auto; padding-top: 22px;
    }
    .meta > ul { margin-bottom: 22px; }
    .foot { border-top: 1px solid var(--line); }
    .result { margin-top: 0; }
    .read { margin-top: 0; margin-left: auto; }

    /* Quotes live on each case study page; keep the gallery tidy */
    .quote { display: none; }
  }
</style>
