---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Stats from '../components/Stats.astro';
import Partners from '../components/Partners.astro';
import Process from '../components/Process.astro';
import CtaBand from '../components/CtaBand.astro';
import { about } from '../content/site';
// Small accent photo beside the story (swap for any image in /public)
const photo = about.homeImages[0];
---
<Base title="About" description="Clear Veil is a small, founder-led marketing team in Michigan. You work directly with the people running your ads, building your site and making your creative.">
  <PageHeader eyebrow="About" title={about.title} />

  <section class="container story">
    <figure class="photo glass">
      <img src={photo.src} alt={photo.alt} width={photo.w} height={photo.h} fetchpriority="high" />
    </figure>
    <div class="text">
      {about.paragraphs.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
    </div>
  </section>

  <Partners />
  <Stats />
  <Process />
  <CtaBand />
</Base>

<style>
  .story {
    display: grid; grid-template-columns: 260px minmax(0, 1fr);
    gap: clamp(36px, 6vw, 96px); align-items: start;
    padding-bottom: clamp(24px, 4vw, 48px);
  }
  .photo { margin: 0; padding: 5px; border-radius: 24px; position: sticky; top: 110px; }
  .photo::after { display: none; }
  .photo img { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 19px; }
  .text { display: grid; gap: 22px; color: var(--ink-2); font-size: var(--fs-lede); max-width: 640px; }
  .lead { color: #fff; font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.7rem); line-height: 1.4; letter-spacing: -0.025em; }
  @media (max-width: 760px) {
    .story { grid-template-columns: 1fr; }
    .photo { position: static; width: 180px; }
  }
</style>
