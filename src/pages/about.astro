---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Stats from '../components/Stats.astro';
import Comparison from '../components/Comparison.astro';
import Partners from '../components/Partners.astro';
import Community from '../components/Community.astro';
import Process from '../components/Process.astro';
import CtaBand from '../components/CtaBand.astro';
import { about } from '../content/site';
---
<Base
  seoTitle="About Clear Veil | Founder-Led Marketing Agency in Michigan"
  description="Clear Veil is a founder-led marketing agency in Michigan. Certified on Meta, Google and Shopify, with $5M+ in managed ad spend and month-to-month terms."
  breadcrumbs={[{ name: 'About', path: '/about' }]}
>
  <PageHeader eyebrow="About" title={about.title} />

  <section class="container story">
    <div class="text">
      {about.paragraphs.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
    </div>
  </section>

  <Partners />
  <Community />
  <Stats />
  <Comparison />
  <Process />
  <CtaBand />
</Base>

<style>
  .story { padding-bottom: clamp(24px, 4vw, 48px); }
  .text { display: grid; gap: 22px; color: var(--ink-2); font-size: var(--fs-lede); max-width: 720px; }
  .lead { color: #fff; font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.7rem); line-height: 1.4; letter-spacing: -0.025em; }
</style>
